        style = ttk.Style(root)
        if "clam" in style.theme_names():
            style.theme_use("clam")
        style.configure("Game.TNotebook", background="#172a36", borderwidth=0)
        style.configure(
            "Game.TNotebook.Tab",
            background="#263d48",
            foreground="#eaf0e6",
            padding=(18, 9),
            font=("Arial", 10, "bold"),
        )
        style.map(
            "Game.TNotebook.Tab",
            background=[("selected", "#ffd166")],
            foreground=[("selected", "#172a36")],
        )
        self.settings_notebook = ttk.Notebook(self.settings, style="Game.TNotebook")
        self.settings_notebook.pack(fill=tk.BOTH, expand=True, pady=(0, 16))
        self.appearance_tab = tk.Frame(self.settings_notebook, bg="#172a36", padx=18, pady=20)
        self.sound_tab = tk.Frame(self.settings_notebook, bg="#172a36", padx=18, pady=20)
        self.gameplay_tab = tk.Frame(self.settings_notebook, bg="#172a36", padx=18, pady=20)
        self.settings_notebook.add(self.appearance_tab, text="Görünüm")
        self.settings_notebook.add(self.sound_tab, text="Ses")
        self.settings_notebook.add(self.gameplay_tab, text="Oynanış")
        tk.Label(
            self.appearance_tab,
            text="RENK TEMASI",
