            bg="#172a36",
            font=("Arial", 12, "bold"),
        )
        self.record_label.pack(pady=(0, 14))
        self.make_button(self.menu, "OYNA", self.show_game, primary=True).pack(pady=7)
        self.make_button(self.menu, "AYARLAR", self.open_settings).pack(pady=5)
        self.make_button(self.menu, "TAM EKRAN", self.toggle_fullscreen).pack(pady=5)
        self.make_button(self.menu, "OYUNU KAPAT", root.destroy).pack(pady=(5, 0))

        self.settings = tk.Frame(root, bg="#172a36", padx=30, pady=24)
        tk.Label(
            self.settings,
            text="AYARLAR",
            fg="#f3f5e9",
            bg="#172a36",
            font=("Arial", 22, "bold"),
