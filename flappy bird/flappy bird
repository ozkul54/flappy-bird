}


class FlappyBird:
    def __init__(self, root):
        self.root = root
        self.root.title("Flappy Bird")
        self.root.resizable(False, False)
        self.fullscreen = False
        self.windowed_geometry = None
        self.windowed_resizable = (False, False)
        self.render_scale = 1
        self.render_offset_x = 0
        self.render_offset_y = 0
        self.theme_name = "Gün"
        self.show_sky_details = True
        self.sound_enabled = True
        self.difficulty = "Normal"
        self.load_settings()
        self.theme = THEMES[self.theme_name]
        self.rules = DIFFICULTIES[self.difficulty]
        self.state = "menu"
        self.after_id = None
        self.score = 0
        self.best_score = self.load_best_score()
        self.bird_y = HEIGHT * 0.42
        self.velocity = 0
        self.pipes = []

        self.menu = tk.Frame(root, bg="#172a36", padx=42, pady=38)
        tk.Label(
            self.menu,
            text="FLAPPY  /  01",
            fg="#ffd166",
            bg="#172a36",
            font=("Arial", 10, "bold"),
        ).pack(pady=(4, 10))
        tk.Label(
            self.menu,
            text="Flappy Bird",
            fg="#f3f5e9",
            bg="#172a36",
            font=("Arial", 30, "bold"),
