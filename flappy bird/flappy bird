            command=self.toggle_sound,
            bg="#172a36",
            fg="#f3f5e9",
            activebackground="#172a36",
            activeforeground="#f3f5e9",
            selectcolor="#29434d",
            font=("Arial", 11),
        ).pack(pady=(0, 16))
        self.make_button(
            self.sound_tab,
            "SESİ DENE",
            lambda: self.play_sound(880, 90),
        ).pack()
        tk.Label(
            self.gameplay_tab,
            text="ZORLUK",
            fg="#b7c9c8",
            bg="#172a36",
            font=("Arial", 9, "bold"),
        ).pack(pady=(0, 10))
        self.difficulty_var = tk.StringVar(value=self.difficulty)
        difficulty_row = tk.Frame(self.gameplay_tab, bg="#172a36")
        difficulty_row.pack()
        for difficulty in DIFFICULTIES:
            tk.Radiobutton(
                difficulty_row,
                text=difficulty,
                value=difficulty,
                variable=self.difficulty_var,
                command=self.change_difficulty,
                indicatoron=False,
                width=9,
                padx=6,
                pady=9,
                bg="#263d48",
                fg="#eaf0e6",
                selectcolor="#ffd166",
                activebackground="#36535d",
                activeforeground="#ffffff",
                font=("Arial", 10, "bold"),
            ).pack(side=tk.LEFT, padx=4)
        self.difficulty_description = tk.Label(
            self.gameplay_tab,
