import json
import random
import tkinter as tk
from tkinter import ttk
from pathlib import Path

try:
    import winsound
except ImportError:
    winsound = None


WIDTH = 480
HEIGHT = 640
GROUND_HEIGHT = 76
GROUND_TOP = HEIGHT - GROUND_HEIGHT
BIRD_X = 120
BIRD_RADIUS = 15
PIPE_WIDTH = 72
PIPE_SPACING = 230

